# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit text files
*.html text eol=lf diff=html
*.css text eol=lf diff=css
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.webp binary
*.mp3 binary
*.wav binary
*.ogg binary
